    {
      "name": "template-block-layout-two-columns",
      "kind": "template",
      "task": "block_layout",
      "prompt": "Put the heading on top and the text in two columns with a divider between the sections.",
      "traits": [
        {
          "key": "first_name",
          "type": "string",
          "description": "Given name"
        },
        {
          "key": "plan",
          "type": "string",
          "description": "Subscription plan"
        }
      ],
      "template": {
        "schema": 2,
        "channel": "email",
        "mode": "blocks",
        "blocks": {
          "subject": "Our news",
          "sender": "0192b1a4-7c3e-7000-8000-00000000a001",
          "lang": "en",
          "category": "transactional",
          "footer": "none",
          "theme": "none",
          "sections": [
            {
              "id": "intro",
              "columns": [
                [
                  {
                    "type": "heading",
                    "id": "h1",
                    "level": 1,
                    "text": "Our news"
                  },
                  {
                    "type": "text",
                    "id": "t1",
                    "content": "<p>Two things happened this month.</p>"
                  }
                ]
              ]
            }
          ]
        }
      },
      "expect": [
        {
          "path": "/document/blocks/sections/*/id",
          "equals": "intro"
        },
        {
          "path": "/document/blocks/sections/*/id",
          "equals": "details"
        },
        {
          "path": "/document/blocks/sections/*/columns/*/*/type",
          "equals": "divider"
        },
        {
          "path": "/document/blocks/subject",
          "equals": "Our news"
        }
      ],
      "replay": [
        {
          "fragment": {
            "sections": [
              {
                "id": "intro",
                "columns": [
                  [
                    {
                      "type": "heading",
                      "id": "h1",
                      "level": 1,
                      "text": "Our news"
                    }
                  ]
                ]
              },
              {
                "id": "rule",
                "columns": [
                  [
                    {
                      "type": "divider",
                      "id": "d1"
                    }
                  ]
                ]
              },
              {
                "id": "details",
                "columns": [
                  [
                    {
                      "type": "text",
                      "id": "t1",
                      "content": "<p>Two things happened this month.</p>"
                    }
                  ],
                  [
                    {
                      "type": "text",
                      "id": "t2",
                      "content": "<p>Read on for the details.</p>"
                    }
                  ]
                ]
              }
            ]
          }
