{
  "cases": [
    {
      "name": "csv-contacts",
      "kind": "mapping",
      "prompt": "The file has a header row. Identify the person by Email, keep First name, Last name and Plan as traits, and add everyone whose Newsletter column is truthy to the Newsletter list.",
      "fields": [
        {"name": "Email", "type": "string"},
        {"name": "First name", "type": "string"},
        {"name": "Last name", "type": "string"},
        {"name": "Plan", "type": "string"},
        {"name": "Newsletter", "type": "string"}
      ],
      "traits": [
        {"key": "first_name", "type": "string", "description": "Given name"},
        {"key": "last_name", "type": "string", "description": "Family name"},
        {"key": "plan", "type": "string", "description": "Subscription plan"}
      ],
      "lists": [{"id": "0190d0f2-0000-7000-8000-0000000000a1", "name": "Newsletter"}],
      "expect": [
        {"path": "/columns/*/column", "equals": "Email"},
        {"path": "/columns/*/target/kind", "equals": "email"},
        {"path": "/columns/*/target/key", "equals": "first_name"},
        {"path": "/columns/*/target/key", "equals": "plan"},
        {"path": "/columns/*/target/type", "equals": "list"},
        {"path": "/columns/*/target/list_id", "equals": "0190d0f2-0000-7000-8000-0000000000a1"},
        {"path": "/event", "absent": true}
      ],
      "replay": [
        {"columns": [
          {"column": "Email", "target": {"type": "identifier", "kind": "email"},
           "transforms": [{"op": "trim"}, {"op": "lower"}]},
          {"column": "First name", "target": {"type": "trait", "key": "first_name"}},
          {"column": "Last name", "target": {"type": "trait", "key": "last_name"}},
          {"column": "Plan", "target": {"type": "trait", "key": "plan"},
           "transforms": [{"op": "lower"}]},
          {"column": "Newsletter",
           "target": {"type": "list", "list_id": "0190d0f2-0000-7000-8000-0000000000a1"}}
        ]}
      ]
    },
    {
      "name": "nested-json-orders",
      "kind": "mapping",
      "prompt": "Each record is a customer with one order. Identify the person by profile.email, keep profile.name as the display name, add them to the Newsletter list when flags.news is set, and record an order_placed event with the total from order.total and the time from order.at.",
      "fields": [
        {"name": "id", "type": "string"},
        {"name": "profile", "type": "json"},
        {"name": "order", "type": "json"},
        {"name": "flags", "type": "json"}
      ],
      "primary_key": ["id"],
      "traits": [
        {"key": "display_name", "type": "string", "description": "The name to greet a person by"}
      ],
      "lists": [{"id": "0190d0f2-0000-7000-8000-0000000000a1", "name": "Newsletter"}],
      "expect": [
        {"path": "/columns/*/column", "equals": "profile.email"},
        {"path": "/columns/*/target/key", "equals": "display_name"},
        {"path": "/columns/*/target/type", "equals": "list"},
        {"path": "/event/name", "equals": "order_placed"},
        {"path": "/event/properties/*/column", "equals": "order.total"},
        {"path": "/event/timestamp/column", "equals": "order.at"},
        {"path": "/key_column", "absent": true}
      ],
      "replay": [
        {
          "columns": [
            {"column": "profile.email", "target": {"type": "identifier", "kind": "email"},
             "transforms": [{"op": "trim"}, {"op": "lower"}]},
            {"column": "profile.name", "target": {"type": "trait", "key": "display_name"}},
            {"column": "flags.news",
             "target": {"type": "list", "list_id": "0190d0f2-0000-7000-8000-0000000000a1"}}
          ],
          "event": {
            "name": "order_placed",
            "timestamp": {"column": "order.at",
                          "transforms": [{"op": "timestamp", "format": "%Y-%m-%d"}]},
            "properties": [{"property": "total", "column": "order.total",
                            "transforms": [{"op": "cast", "to": "number"}]}]
          }
        }
      ]
    },
    {
      "name": "repairs-a-field-that-does-not-exist",
      "kind": "mapping",
      "prompt": "Identify the person by their email address and keep their name.",
      "fields": [
        {"name": "Email", "type": "string"},
        {"name": "Name", "type": "string"}
      ],
      "traits": [
        {"key": "display_name", "type": "string", "description": "The name to greet a person by"}
      ],
      "expect": [
        {"path": "/columns/*/column", "equals": "Email"},
        {"path": "/columns/*/target/key", "equals": "display_name"}
      ],
      "replay": [
        {"columns": [
          {"column": "E-mail", "target": {"type": "identifier", "kind": "email"}}
        ]},
        {"columns": [
          {"column": "Email", "target": {"type": "identifier", "kind": "email"}},
          {"column": "Name", "target": {"type": "trait", "key": "display_name"}}
        ]}
      ]
    },
    {
      "name": "cursor-pagination-bearer-token",
      "kind": "manifest",
      "prompt": "Read the contacts of our CRM and keep them up to date.",
      "documentation": "Acme CRM API v2\n\nBase URL: https://api.acme.example/v2\nAuthentication: send your token as a Bearer token in the Authorization header.\n\nGET /contacts\nReturns {\"data\": [...], \"meta\": {\"next_cursor\": \"abc\"}}. Pass the value of meta.next_cursor as the cursor query parameter to get the next page; it is null on the last page. The limit query parameter sets the page size (up to 100). The updated_since parameter returns only contacts changed after the given RFC 3339 time.\nEach contact has id (string), email (string) and updated_at (RFC 3339 timestamp).",
      "expect": [
        {"path": "/base_url", "equals": "https://api.acme.example/v2"},
        {"path": "/auth/type", "equals": "bearer"},
        {"path": "/streams/*/name", "equals": "contacts"},
        {"path": "/streams/*/records_path", "equals": "/data"},
        {"path": "/streams/*/pagination/type", "equals": "cursor"},
        {"path": "/streams/*/pagination/next", "equals": "/meta/next_cursor"},
        {"path": "/streams/*/primary_key", "contains": "id"},
        {"path": "/streams/*/incremental/request_param", "equals": "updated_since"}
      ],
      "replay": [
        {"manifest": {
          "version": "v1",
          "base_url": "https://api.acme.example/v2",
          "auth": {"type": "bearer"},
          "streams": [{
            "name": "contacts",
            "path": "/contacts",
            "query": {"limit": 100},
            "records_path": "/data",
            "pagination": {"type": "cursor", "param": "cursor", "next": "/meta/next_cursor"},
            "fields": [
              {"name": "id", "type": "string"},
              {"name": "email", "type": "string"},
              {"name": "updated_at", "type": "timestamp"}
            ],
            "primary_key": ["id"],
            "incremental": {"cursor_field": "updated_at", "request_param": "updated_since",
                            "cursor_type": "timestamp"}
          }]
        }}
      ]
    },
    {
      "name": "link-header-pagination-api-key",
      "kind": "manifest",
      "prompt": "Read the people from this API.",
      "documentation": "People directory API\n\nBase URL: https://people.example.org/v1\nAuthenticate by sending your key in the X-Api-Key request header.\n\nGET /people\nReturns a JSON array of people, each with id (string), email (string) and name (string). The response has a Link header with rel=\"next\" while more pages remain.",
      "expect": [
        {"path": "/auth/type", "equals": "api_key"},
        {"path": "/auth/in", "equals": "header"},
        {"path": "/auth/name", "equals": "X-Api-Key"},
        {"path": "/streams/*/name", "equals": "people"},
        {"path": "/streams/*/records_path", "equals": ""},
        {"path": "/streams/*/pagination/type", "equals": "link_header"}
      ],
      "replay": [
        {"manifest": {
          "version": "v1",
          "base_url": "https://people.example.org/v1",
          "auth": {"type": "api_key", "in": "header", "name": "X-Api-Key"},
          "streams": [{
            "name": "people",
            "path": "/people",
            "records_path": "",
            "pagination": {"type": "link_header"},
            "fields": [
              {"name": "id", "type": "string"},
              {"name": "email", "type": "string"},
              {"name": "name", "type": "string"}
            ],
            "primary_key": ["id"]
          }]
        }}
      ]
    },
    {
      "name": "repairs-an-unknown-key",
      "kind": "manifest",
      "prompt": "Read the products of this public API.",
      "documentation": "Public catalog API. No authentication.\n\nBase URL: https://catalog.example.net/api\n\nGET /products?offset=0&limit=50\nReturns {\"items\": [...]}. Increase offset by the limit to get the next page; the largest limit is 200. Each product has sku (string) and title (string).",
      "expect": [
        {"path": "/auth/type", "equals": "none"},
        {"path": "/streams/*/records_path", "equals": "/items"},
        {"path": "/streams/*/pagination/type", "equals": "offset"},
        {"path": "/streams/*/primary_key", "contains": "sku"},
        {"path": "/retries", "absent": true}
      ],
      "replay": [
        {"manifest": {
          "version": "v1",
          "base_url": "https://catalog.example.net/api",
          "auth": {"type": "none"},
          "retries": 3,
          "streams": [{
            "name": "products",
            "path": "/products",
            "records_path": "/items",
            "pagination": {"type": "offset", "param": "offset", "limit_param": "limit", "limit": 50},
            "fields": [
              {"name": "sku", "type": "string"},
              {"name": "title", "type": "string"}
            ],
            "primary_key": ["sku"]
          }]
        }},
        {"manifest": {
          "version": "v1",
          "base_url": "https://catalog.example.net/api",
          "auth": {"type": "none"},
          "streams": [{
            "name": "products",
            "path": "/products",
            "records_path": "/items",
            "pagination": {"type": "offset", "param": "offset", "limit_param": "limit", "limit": 50},
            "fields": [
              {"name": "sku", "type": "string"},
              {"name": "title", "type": "string"}
            ],
            "primary_key": ["sku"]
          }]
        }}
      ]
    },
    {
      "name": "segment-nordic-buyers",
      "kind": "segment",
      "prompt": "People in Denmark, Sweden or Norway who placed at least two orders of 50 or more in the last 90 days, who are not on the VIP list and who are subscribed to the newsletter.",
      "traits": [
        {"key": "country", "type": "string", "description": "Two-letter country code"},
        {"key": "plan", "type": "string", "description": "Subscription plan"}
      ],
      "events": [
        {"name": "order_placed", "properties": [
          {"name": "total", "type": "number"},
          {"name": "currency", "type": "string"}
        ]}
      ],
      "lists": [{"id": "0190d0f2-0000-7000-8000-0000000000a2", "name": "VIP"}],
      "topics": [{"channel": "email", "key": "newsletter", "name": "Newsletter"}],
      "expect": [
        {"path": "/all/0/trait", "equals": "country"},
        {"path": "/all/0/value", "contains": "DK"},
        {"path": "/all/1/event", "equals": "order_placed"},
        {"path": "/all/1/where/0/prop", "equals": "total"},
        {"path": "/all/1/agg/fn", "equals": "count"},
        {"path": "/all/1/window/last", "equals": "P90D"},
        {"path": "/all/2/not/list", "equals": "0190d0f2-0000-7000-8000-0000000000a2"},
        {"path": "/all/3/consent/topic", "equals": "newsletter"}
      ],
      "replay": [
        {"definition": {"v": 1, "all": [
          {"trait": "country", "op": "in", "value": ["DK", "SE", "NO"]},
          {"event": "order_placed", "where": [{"prop": "total", "op": "gte", "value": 50}],
           "agg": {"fn": "count", "op": "gte", "value": 2}, "window": {"last": "P90D"}},
          {"not": {"list": "0190d0f2-0000-7000-8000-0000000000a2"}},
          {"consent": {"channel": "email", "topic": "newsletter", "status": "subscribed"}}
        ]}}
      ]
    },
    {
      "name": "segment-repairs-an-unknown-trait",
      "kind": "segment",
      "prompt": "Customers in Sweden.",
      "traits": [
        {"key": "country", "type": "string", "description": "Two-letter country code"},
        {"key": "plan", "type": "string", "description": "Subscription plan"}
      ],
      "expect": [
        {"path": "/trait", "equals": "country"},
        {"path": "/value", "equals": "SE"}
      ],
      "replay": [
        {"definition": {"v": 1, "trait": "nation", "op": "eq", "value": "SE"}},
        {"definition": {"v": 1, "trait": "country", "op": "eq", "value": "SE"}}
      ]
    },
    {
      "name": "segment-keeps-a-literal-it-was-not-shown",
      "kind": "segment",
      "prompt": "Keep the cities as they are, and require the pro plan instead of the free plan.",
      "traits": [
        {"key": "city", "type": "string", "description": "City of residence", "pii": true},
        {"key": "plan", "type": "string", "description": "Subscription plan"}
      ],
      "definition": {"v": 1, "all": [
        {"trait": "city", "op": "in", "value": ["Aarhus", "Odense"]},
        {"trait": "plan", "op": "eq", "value": "free"}
      ]},
      "expect": [
        {"path": "/all/0/value", "contains": "Aarhus"},
        {"path": "/all/0/value", "contains": "Odense"},
        {"path": "/all/1/value", "equals": "pro"}
      ],
      "replay": [
        {"definition": {"v": 1, "all": [
          {"trait": "city", "op": "in", "value": ["(kept:1)", "(kept:2)"]},
          {"trait": "plan", "op": "eq", "value": "pro"}
        ]}}
      ]
    },
    {
      "name": "explain-nordic-buyers",
      "kind": "explain",
      "prompt": "Explain the segment.",
      "traits": [
        {"key": "country", "type": "string", "description": "Two-letter country code"}
      ],
      "events": [
        {"name": "order_placed", "properties": [{"name": "total", "type": "number"}]}
      ],
      "lists": [{"id": "0190d0f2-0000-7000-8000-0000000000a2", "name": "VIP"}],
      "topics": [{"channel": "email", "key": "newsletter", "name": "Newsletter"}],
      "definition": {"v": 1, "all": [
        {"trait": "country", "op": "in", "value": ["DK", "SE", "NO"]},
        {"event": "order_placed", "where": [{"prop": "total", "op": "gte", "value": 50}],
         "agg": {"fn": "count", "op": "gte", "value": 2}, "window": {"last": "P90D"}},
        {"not": {"list": "0190d0f2-0000-7000-8000-0000000000a2"}},
        {"consent": {"channel": "email", "topic": "newsletter", "status": "subscribed"}}
      ]},
      "expect": [
        {"path": "/summary", "contains": "Nordic"},
        {"path": "/nodes/*/pointer", "equals": "/all/0"},
        {"path": "/nodes/*/pointer", "equals": "/all/1"},
        {"path": "/nodes/*/pointer", "equals": "/all/2/not"},
        {"path": "/nodes/*/pointer", "equals": "/all/3"},
        {"path": "/nodes/*/text", "contains": "VIP"}
      ],
      "replay": [
        {"summary": "Nordic customers who ordered recently, are not VIPs and receive the newsletter.",
         "nodes": [
           {"pointer": "/all/0", "text": "The country is Denmark, Sweden or Norway."},
           {"pointer": "/all/1", "text": "They placed at least two orders of 50 or more in the last 90 days."},
           {"pointer": "/all/2/not", "text": "They are not on the VIP list."},
           {"pointer": "/all/3", "text": "They are subscribed to the newsletter by email."}
         ]}
      ]
    }
  ]
}
