            "description": "No such workspace or member, or no access",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "api_key": []
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is serving requests. Never touches the database.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusBody"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: the database is reachable and its schema is up to date.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready to serve",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusBody"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable or its schema is not up to date",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiKeyBody": {
        "type": "object",
        "required": [
          "id",
          "name",
          "scopes",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Any of `ingest`, `read`, `write`, `admin`.",
            "example": [
              "read"
            ]
          }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": [
          "name",
          "scopes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "1 to 100 characters.",
            "example": "ingest worker"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "At least one of `ingest`, `read`, `write`, `admin`.",
            "example": [
              "read"
            ]
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "password": {
            "type": "string",
            "description": "12 to 1024 characters."
          }
        }
      },
      "CreateWorkspaceRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "1 to 100 characters.",
            "example": "Acme Corp"
          },
          "slug": {
            "type": [
              "string",
              "null"
            ],
            "description": "`a-z`, `0-9` and `-`, up to 63 characters. Derived from the name when omitted.",
            "example": "acme-corp"
          }
        }
      },
      "CreatedApiKeyBody": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiKeyBody"
          },
          {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "description": "The full key (`zfk_...`) to send as `Authorization: Bearer`. Shown once; only a hash\nof its secret is stored."
              }
            }
          }
        ]
      },
      "MemberBody": {
        "type": "object",
        "required": [
          "user_id",
          "email",
          "role",
          "added_at"
        ],
        "properties": {
          "added_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "`admin` or `member`.",
            "example": "member"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem document.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The `x-request-id` of the failed request."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Problem type URI; `about:blank` until specific types are defined.",
            "example": "about:blank"
          }
        }
      },
      "RoleBody": {
        "type": "object",
        "required": [
          "user_id",
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "example": "member"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SessionBody": {
        "type": "object",
        "required": [
          "user",
          "csrf_token"
        ],
        "properties": {
          "csrf_token": {
            "type": "string",
            "description": "Send this as `x-csrf-token` on every POST, PUT, PATCH and DELETE made with the cookie."
          },
          "user": {
            "$ref": "#/components/schemas/UserBody"
          }
        }
      },
      "SetRoleRequest": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "`admin` or `member`."
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@example.com"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "StatusBody": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "UserBody": {
        "type": "object",
        "description": "A user as shown to API callers; never includes the password hash.",
        "required": [
          "id",
          "email",
          "is_owner"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_owner": {
            "type": "boolean"
          }
        }
      },
      "VersionBody": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "The running zirv-flow version."
          }
        }
      },
      "WorkspaceBody": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "http",
        "scheme": "bearer",
        "description": "Workspace API key (zfk_...). Valid only for its own workspace and within its scopes."
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "zf_session",
        "description": "Session cookie set by POST /api/v1/session. Every POST, PUT, PATCH and DELETE              made with it must also send the CSRF token in the x-csrf-token header."
      }
    }
  }
}
