{
  "openapi": "3.1.0",
  "info": {
    "title": "zirv-flow API",
    "description": "HTTP API of the zirv-flow server.",
    "contact": {
      "name": "Jonathan Solskov",
      "email": "josj@zirv.io"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/session": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "The signed-in user and their CSRF token.",
        "operationId": "current",
        "responses": {
          "200": {
            "description": "The current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "An API key cannot use this endpoint",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Signs in with an e-mail and password and starts a session.",
        "description": "Sets the `zf_session` cookie (HttpOnly, SameSite=Lax). An unknown e-mail, a wrong\npassword and a locked account all give the same 401. Five failures in a row lock the\naccount for a growing time, up to 15 minutes.",
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Malformed email",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      },
      "delete": {
        "tags": [
          "session"
        ],
        "summary": "Signs out: ends the session and clears the cookie. Needs the CSRF token.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing or invalid CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/session/oidc/callback": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Finishes an OIDC sign-in: the identity provider sends the browser here with `code` and\n`state`.",
        "description": "On success redirects to the server's public URL with the `zf_session` cookie set. Any\nfailure is the same 401, and clears the `zf_oidc_state` cookie.",
        "operationId": "callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "description": "The authorization code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Must match the zf_oidc_state cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "description": "Set by the identity provider when it refused",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Signed in; redirect to the server's public URL, sets the zf_session cookie"
          },
          "401": {
            "description": "Sign-in failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "OIDC sign-in is not configured",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/session/oidc/start": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Starts an OIDC sign-in: redirects the browser to the identity provider.",
        "description": "Sets the `zf_oidc_state` cookie (HttpOnly, SameSite=Lax) that the callback needs.",
        "operationId": "start",
        "responses": {
          "303": {
            "description": "Redirect to the identity provider; sets the zf_oidc_state cookie"
          },
          "404": {
            "description": "OIDC sign-in is not configured",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider cannot be reached",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
