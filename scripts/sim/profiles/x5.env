# The x5 profile: 500 k people at a daily-curve peak of 6,500 events/s (`sim.sh rate 3490`; the
# curve's peak over mean is 1.862). The ingest generator carries 68 % (about 4,400/s at peak) and
# Kafka 22 % (about 1,430/s). Limits are caps, not reservations.
#
# Budget (operator's fixed budget; the Docker VM has 32 CPUs and 33.5 GB and is never raised)
#   application (serve, worker, scheduler): 8 CPUs, 10.5 GB of the 16 GB allowed
#     zf-serve-1, zf-serve-2        1 CPU,     1 GB   each  -> 2 CPUs,   2 GB
#     zf-worker-1 to zf-worker-4    1.375 CPUs, 2 GB  each  -> 5.5 CPUs,  8 GB
#     zf-scheduler                  0.5 CPUs, 512 MB        -> 0.5 CPUs, 0.5 GB
#   database: zf-db                 8 CPUs, 10 GB (shared_buffers 4GB, effective_cache_size 8GB, jit off, checkpoint_timeout 30min)
#   the rest (not counted in either): about 9.2 CPUs and 10 GB
#     kafka 1.5 CPUs 2 GB (heap 1 GB); gen-ingest 2 CPUs 512 MB (2 processes); gen-kafka 0.75 CPUs 512 MB;
#     gen-changes 0.75 CPUs 256 MB; gen-forms 0.25 CPUs 128 MB; lb 1 CPU 256 MB; edge 0.25 CPUs 192 MB;
#     company-pg 1 CPU 2 GB; company-mysql 0.5 CPUs 1.5 GB; prometheus 0.25 CPUs 1 GB;
#     fixtures (billing, mailer, smtp-sink, receiver, dns) about 0.95 CPUs 1.7 GB
#   all limits together: about 25.2 CPUs and 30.4 GB (the seed container's 1.5 GB runs only while
#   seeding, before traffic).
# Workers 3 and 4 are extra compose services under the compose profile `workers-x5`, which
# COMPOSE_PROFILES below enables (compose has no replica count that fits the fixed service names
# and Prometheus targets of the small and full profiles).
COMPOSE_PROFILES=workers-x5
# Drain lanes: ingest.drain_shards is 16 (Investigation Q: 8 lanes were wait-bound) and a shard job
# holds a slot, so 4 workers x 4 slots cover the shards. A worker holds at most
# D + 3 * (concurrency + slots) + 1 = 10 + 3 * (8 + 4) + 1 = 47 connections, so the ceiling is
# 4 * 47 + 2 serves * (24 + explorer 4) + scheduler 10 = 188 + 56 + 10 = 254, under zf-db's
# max_connections of 350.
SIM_DRAIN_SHARDS=16
SIM_DRAIN_SLOTS=4
SIM_PG_MAX_CONNECTIONS=350
# Investigation Q's database settings: queue tables vacuumed often, backends no longer writing
# their own evicted buffers, NVMe cost model, WAL write timing.
SIM_PG_AUTOVACUUM_NAPTIME=5s
SIM_PG_AUTOVACUUM_WORKERS=5
SIM_PG_BGWRITER_DELAY=20ms
SIM_PG_BGWRITER_MAXPAGES=1000
SIM_PG_RANDOM_PAGE_COST=1.1
SIM_PG_IO_CONCURRENCY=200
SIM_PG_WAL_IO_TIMING=on
SIM_IMAGE_TAG=0.235.0
SIM_PEOPLE=500000
SIM_RETENTION_DAYS=2
SIM_SUBNET=172.29.77.0/24
SIM_SUBNET_BASE=172.29.77
# About 580 bytes per event, so 5x is about 177 GB a day.
SIM_MAX_DB_GB=150
SIM_PG_SHARED_BUFFERS=4GB
SIM_PG_CACHE_SIZE=8GB
SIM_PG_MAINTENANCE_MEM=1GB
SIM_PG_JIT=off
SIM_PG_CHECKPOINT_TIMEOUT=30min
SIM_PG_MAX_WAL=64GB
SIM_MEM_ZF_DB=10g
SIM_CPUS_ZF_DB=8
SIM_MEM_SERVE=1g
SIM_CPUS_SERVE=1
SIM_MEM_WORKER=2g
SIM_CPUS_WORKER=1.375
SIM_MEM_SCHEDULER=512m
SIM_CPUS_SCHEDULER=0.5
SIM_MEM_COMPANY_PG=2g
SIM_CPUS_COMPANY_PG=1
SIM_MEM_COMPANY_MYSQL=1536m
SIM_CPUS_COMPANY_MYSQL=0.5
SIM_MYSQL_BUFFER_POOL=768M
SIM_MEM_KAFKA=2g
SIM_CPUS_KAFKA=1.5
SIM_KAFKA_HEAP=-Xmx1g
SIM_MEM_PROMETHEUS=1g
SIM_MEM_BILLING=768m
SIM_MEM_MAILER=512m
# Generators: 24 sender threads keep a 60-event chunk's round trip under 350 ms at the 3x burst.
# One Python process tops out near 7,700/s and the 3x burst is 13,260/s, so gen-ingest runs 2
# processes (12 threads each, each pacing half the rate) on about 2 cores.
# gen-changes delivered 289 of 520/s at 0.25 CPU, so it gets 0.75; company-pg throttled at 0.5.
SIM_GEN_INGEST_WORKERS=24
SIM_GEN_INGEST_PROCS=2
SIM_CPUS_GEN_INGEST=2
SIM_CPUS_GEN_CHANGES=0.75
SIM_MEM_GEN_INGEST=512m
SIM_CPUS_GEN_KAFKA=0.75
SIM_MEM_GEN_KAFKA=512m
SIM_CPUS_LB=1
SIM_MEM_LB=256m
# start waits this long for the first syncs before it publishes the event-driven flows
# (the full profile's 64800 scaled to half the people).
SIM_BACKFILL_TIMEOUT=32400
