# The x5 profile: 500 k people at a daily-curve peak of 6,500 events/s (`sim.sh rate 3490`; the
# curve's peak over mean is 1.862). The ingest generator carries 68 % (about 4,400/s at peak) and
# Kafka 22 % (about 1,430/s). Limits are caps, not reservations.
#
# Budget (operator's fixed budget; the Docker VM has 32 CPUs and 33.5 GB and is never raised)
#   application (serve, worker, scheduler): 8 CPUs, 10.5 GB of the 16 GB allowed
#     zf-serve-1, zf-serve-2        1 CPU,     1 GB   each  -> 2 CPUs,   2 GB
#     zf-worker-1 to zf-worker-4    1.375 CPUs, 2 GB  each  -> 5.5 CPUs,  8 GB
#     zf-scheduler                  0.5 CPUs, 512 MB        -> 0.5 CPUs, 0.5 GB
#   database: zf-db                 8 CPUs, 10 GB (shared_buffers 2560MB, effective_cache_size 6GB)
#   the rest (not counted in either): about 7.7 CPUs and 10 GB
#     kafka 1.5 CPUs 2 GB (heap 1 GB); gen-ingest 1.5 CPUs 512 MB; gen-kafka 0.75 CPUs 512 MB;
#     gen-changes 0.25 CPUs 256 MB; gen-forms 0.25 CPUs 128 MB; lb 1 CPU 256 MB; edge 0.25 CPUs 192 MB;
#     company-pg 0.5 CPUs 2 GB; company-mysql 0.5 CPUs 1.5 GB; prometheus 0.25 CPUs 1 GB;
#     fixtures (billing, mailer, smtp-sink, receiver, dns) about 0.95 CPUs 1.7 GB
#   all limits together: about 23.7 CPUs and 30.4 GB (the seed container's 1.5 GB runs only while
#   seeding, before traffic).
# Workers 3 and 4 are extra compose services under the compose profile `workers-x5`, which
# COMPOSE_PROFILES below enables (compose has no replica count that fits the fixed service names
# and Prometheus targets of the small and full profiles).
COMPOSE_PROFILES=workers-x5
# Drain slots: ingest.drain_shards is 8 and a shard job holds a slot, so 4 workers x 2 slots cover
# the shards. A worker holds at most D + 3 * (concurrency + slots) + 1 = 10 + 3 * (8 + 2) + 1 = 41
# connections, so the ceiling is 4 * 41 + 2 serves * (24 + explorer 4) + scheduler 10 = 164 + 56 + 10 = 230,
# under zf-db's max_connections of 250. (The default of one slot per shard would be
# 4 * 59 + 56 + 10 = 302.)
SIM_DRAIN_SLOTS=2
SIM_IMAGE_TAG=0.235.0
SIM_PEOPLE=500000
SIM_RETENTION_DAYS=2
SIM_SUBNET=172.29.77.0/24
SIM_SUBNET_BASE=172.29.77
# About 580 bytes per event, so 5x is about 177 GB a day.
SIM_MAX_DB_GB=150
SIM_PG_SHARED_BUFFERS=2560MB
SIM_PG_CACHE_SIZE=6GB
SIM_PG_MAINTENANCE_MEM=1GB
SIM_PG_MAX_WAL=64GB
SIM_MEM_ZF_DB=10g
SIM_CPUS_ZF_DB=8
SIM_MEM_SERVE=1g
SIM_CPUS_SERVE=1
SIM_MEM_WORKER=2g
SIM_CPUS_WORKER=1.375
SIM_MEM_SCHEDULER=512m
SIM_CPUS_SCHEDULER=0.5
SIM_MEM_COMPANY_PG=2g
SIM_CPUS_COMPANY_PG=0.5
SIM_MEM_COMPANY_MYSQL=1536m
SIM_CPUS_COMPANY_MYSQL=0.5
SIM_MYSQL_BUFFER_POOL=768M
SIM_MEM_KAFKA=2g
SIM_CPUS_KAFKA=1.5
SIM_KAFKA_HEAP=-Xmx1g
SIM_MEM_PROMETHEUS=1g
SIM_MEM_BILLING=768m
SIM_MEM_MAILER=512m
# Generators: 24 sender threads keep a 60-event chunk's round trip under 350 ms at the 3x burst.
SIM_GEN_INGEST_WORKERS=24
SIM_CPUS_GEN_INGEST=1.5
SIM_MEM_GEN_INGEST=512m
SIM_CPUS_GEN_KAFKA=0.75
SIM_MEM_GEN_KAFKA=512m
SIM_CPUS_LB=1
SIM_MEM_LB=256m
# start waits this long for the first syncs before it publishes the event-driven flows
# (the full profile's 64800 scaled to half the people).
SIM_BACKFILL_TIMEOUT=32400
