# The full profile: 1 M people and the limits of design section 1.1.
SIM_IMAGE_TAG=0.235.0
# Drain slots: 2 workers x 4 slots cover ingest.drain_shards (8); the connection ceiling is
# 2 * (10 + 3 * (8 + 4) + 1) + 48 + 10 = 152, under zf-db's max_connections of 250.
SIM_DRAIN_SLOTS=4
SIM_PEOPLE=1000000
SIM_RETENTION_DAYS=5
SIM_SUBNET=172.29.77.0/24
SIM_SUBNET_BASE=172.29.77
SIM_MAX_DB_GB=120
SIM_PG_SHARED_BUFFERS=3GB
SIM_PG_CACHE_SIZE=6GB
SIM_PG_MAINTENANCE_MEM=512MB
SIM_PG_MAX_WAL=32GB
SIM_MEM_ZF_DB=8g
SIM_CPUS_ZF_DB=2
SIM_MEM_SERVE=1536m
SIM_CPUS_SERVE=0.5
SIM_MEM_WORKER=2560m
SIM_CPUS_WORKER=0.75
SIM_MEM_SCHEDULER=512m
SIM_CPUS_SCHEDULER=0.25
SIM_MEM_COMPANY_PG=2g
SIM_CPUS_COMPANY_PG=0.5
SIM_MEM_COMPANY_MYSQL=1536m
SIM_CPUS_COMPANY_MYSQL=0.5
SIM_MYSQL_BUFFER_POOL=768M
SIM_MEM_KAFKA=1536m
SIM_CPUS_KAFKA=0.5
SIM_KAFKA_HEAP=-Xmx1g
SIM_MEM_PROMETHEUS=1g
SIM_MEM_BILLING=768m
SIM_MEM_MAILER=512m
# start waits this long for the first syncs before it publishes the event-driven flows.
SIM_BACKFILL_TIMEOUT=64800
