# The small profile: 100 k people, memory and CPU limits roughly halved.
SIM_IMAGE_TAG=0.235.0
# Drain slots: ingest.drain_shards is 8, so 2 workers x 4 slots cover the shards. A worker holds at
# most D + 3 * (concurrency + slots) + 1 = 10 + 3 * (8 + 4) + 1 = 47 connections, so the ceiling is
# 2 * 47 + 2 serves * 24 + scheduler 10 = 94 + 48 + 10 = 152, under zf-db's max_connections of 250.
SIM_DRAIN_SLOTS=4
SIM_PEOPLE=100000
SIM_RETENTION_DAYS=5
SIM_SUBNET=172.29.77.0/24
SIM_SUBNET_BASE=172.29.77
SIM_MAX_DB_GB=40
SIM_PG_SHARED_BUFFERS=1GB
SIM_PG_CACHE_SIZE=2GB
SIM_PG_MAINTENANCE_MEM=256MB
SIM_PG_MAX_WAL=8GB
SIM_MEM_ZF_DB=3g
SIM_CPUS_ZF_DB=1.5
SIM_MEM_SERVE=1g
SIM_CPUS_SERVE=0.5
SIM_MEM_WORKER=1536m
SIM_CPUS_WORKER=0.75
SIM_MEM_SCHEDULER=384m
SIM_CPUS_SCHEDULER=0.25
SIM_MEM_COMPANY_PG=1g
SIM_CPUS_COMPANY_PG=0.5
SIM_MEM_COMPANY_MYSQL=1g
SIM_CPUS_COMPANY_MYSQL=0.5
SIM_MYSQL_BUFFER_POOL=256M
SIM_MEM_KAFKA=1g
SIM_CPUS_KAFKA=0.5
SIM_KAFKA_HEAP=-Xmx512m
SIM_MEM_PROMETHEUS=512m
SIM_MEM_BILLING=512m
SIM_MEM_MAILER=384m
# start waits this long for the first syncs before it publishes the event-driven flows.
SIM_BACKFILL_TIMEOUT=14400
