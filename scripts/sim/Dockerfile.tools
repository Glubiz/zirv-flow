# The one image every sim fixture and generator runs in: the host has no usable Python.
FROM python:3.12.8-slim@sha256:2199a62885a12290dc9c5be3ca0681d367576ab7bf037da120e564723292a2f0
RUN pip install --no-cache-dir \
    "psycopg[binary]==3.3.8" \
    PyMySQL==1.2.3 \
    confluent-kafka==2.16.1
WORKDIR /sim
